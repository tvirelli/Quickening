<Page
    x:Class="Quickening.App.Views.ScanFailedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    Background="Transparent">

    <!--
        Screen 3d in design-handoff/Quickening Screens.dc.html - reached when
        a scan throws mid-operation. The reassurance line ("nothing was moved
        or changed") is mandatory copy per DESIGN-SPEC.md §7, and the error
        chip shows the REAL exception's HResult/Message (never a fabricated
        Windows error code) - see ScanFailedPage.xaml.cs's OnNavigatedTo.
    -->
    <Grid>
        <!-- Ambient glow: 3d's "radial-gradient(closest-side, rgba(255,138,92,0.08), rgba(255,138,92,0))" -->
        <Ellipse Width="680" Height="560" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-50,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#14FF8A5C" Offset="0" />
                    <GradientStop Color="#00FF8A5C" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,108,0,0">
            <!-- Warning badge: 120px circle, rgba(255,138,92,.07) fill / .35 border, per 3d -->
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="#12FF8A5C" Stroke="#59FF8A5C" StrokeThickness="1.5" />
                <Viewbox Width="44" Height="44">
                    <Canvas Width="44" Height="44">
                        <Rectangle Canvas.Left="19.5" Canvas.Top="9" Width="5" Height="18" RadiusX="2.5" RadiusY="2.5"
                                   Fill="{StaticResource WarningBrush}" />
                        <Ellipse Canvas.Left="19" Canvas.Top="31" Width="6" Height="6" Fill="{StaticResource WarningBrush}" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <TextBlock Text="Well, that wasn't the plan." HorizontalAlignment="Center" Margin="0,32,0,0"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeEmptyStateHeadline}" FontWeight="Bold"
                       CharacterSpacing="{StaticResource TrackingTight1px}"
                       Foreground="{StaticResource TextHeadingBrush}" />

            <TextBlock x:Name="SubtitleText" HorizontalAlignment="Center" Margin="0,12,0,0"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextMutedBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />

            <!-- Copyable error-code chip - whole chip is clickable (per 3d's own "cursor: pointer" on the chip div) -->
            <Button Click="CopyDetails_Click" Margin="0,24,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Center">
                <Border Padding="20,12" CornerRadius="14"
                        Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="ErrorCodeText" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Copy details" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentLightBrush}" />
                    </StackPanel>
                </Border>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,44,0,0">
                <Button Click="TryAgain_Click" Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="44,16" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Try that scan again" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="{StaticResource FontSizeCta}" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
                <Button Content="Back home" Click="BackHome_Click" Padding="30,16"
                        controls:PillCornerRadius.Enabled="True" Background="Transparent"
                        Foreground="{StaticResource TextBodyEmphasisBrush}"
                        FontFamily="{StaticResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold"
                        BorderBrush="{StaticResource SecondaryButtonBorderBrush}" BorderThickness="1.5" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
