<Page
    x:Class="Quickening.App.Views.DuplicateFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    NavigationCacheMode="Disabled">

    <!--
        Duplicate folders (F8): sets of whole folders that are exact copies of
        each other. Each set is a card - keep one copy, remove the rest to the
        Recycle Bin. Cards are built in code-behind (DuplicateFoldersPage.xaml.cs)
        because the number of sets and folders-per-set is dynamic.
    -->
    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: back-link + title + count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Padding="28,10,28,12" VerticalAlignment="Center">
            <Button Click="BackToSummary_Click" Background="Transparent" BorderThickness="0" Padding="0"
                    AutomationProperties.Name="Back to Summary">
                <TextBlock Text="&#x2190; Summary" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
            </Button>
            <TextBlock Text="Duplicate folders" FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                       Foreground="{StaticResource TextHeadingBrush}" />
            <TextBlock x:Name="SummaryText" FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,0,28,12" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" Spacing="16" />
        </ScrollViewer>

        <!-- Sticky footer: selected count + Remove -->
        <Border Grid.Row="2" Background="{StaticResource FooterBarAcrylicBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <TextBlock x:Name="SelectedCalloutText" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button x:Name="RemoveButton" Click="RemoveButton_Click" HorizontalAlignment="Right"
                        Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="40,14" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Remove Extra Copies &#x26A1;" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="16" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
