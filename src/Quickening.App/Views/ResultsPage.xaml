<Page
    x:Class="Quickening.App.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Quickening.App.Converters"
    xmlns:controls="using:Quickening.App.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <!--
        Screen 2g in design-handoff/Quickening Screens.dc.html - see
        DESIGN-SPEC.md §5. MainWindow.xaml already draws the shared 48px
        title-bar strip above this page's Frame; every offset below is
        measured from the top of this page's own content area, matching
        2g's content starting right after its identical header. This is the
        Duplicates (grouped) results view - flat background per
        DESIGN-SPEC.md §1 ("bg.base - flat screens (results lists)"), not the
        gradient hero background HomePage/ProgressPage/ScanCompletePage use.
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToDoubleConverter x:Key="NetworkRowOpacityConverter" TrueValue="0.55" FalseValue="1" />
        <converters:BoolToDoubleConverter x:Key="IgnoredRowOpacityConverter" TrueValue="0.45" FalseValue="1" />
        <converters:CategoryIconTemplateConverter x:Key="CategoryIconTemplateConverter" />
        <converters:CategoryFillBrushConverter x:Key="CategoryFillBrushConverter" />
        <converters:GroupSwatchBrushConverter x:Key="GroupSwatchBrushConverter" />
        <converters:GroupRepresentativeFileNameConverter x:Key="GroupRepresentativeFileNameConverter" />
        <converters:GroupCopiesLabelConverter x:Key="GroupCopiesLabelConverter" />
        <converters:GroupFreesLabelConverter x:Key="GroupFreesLabelConverter" />
        <converters:FileNameFromPathConverter x:Key="FileNameFromPathConverter" />
        <converters:DirectoryFromPathConverter x:Key="DirectoryFromPathConverter" />
        <converters:LastWriteDateConverter x:Key="LastWriteDateConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />

        <!--
            Per-row corner-rounding/border/margin for GroupsListView's now-
            flattened header+file rows - see ResultsPage.xaml.cs's
            RebuildFlatRows doc comment for why this is flattened at all.
            Header rows are always "top of card" (rounded top corners, no
            bottom border); file rows use these two converters to look like
            a plain middle row normally, or the closing/bottom row of the
            card on the last file in its group.
        -->
        <converters:BoolToCornerRadiusConverter x:Key="LastInGroupCornerRadiusConverter"
                                                 TrueValue="0,0,18,18" FalseValue="0" />
        <converters:BoolToThicknessConverter x:Key="LastInGroupBorderThicknessConverter"
                                              TrueValue="1,0,1,1" FalseValue="1,0,1,0" />
        <converters:BoolToThicknessConverter x:Key="LastInGroupMarginConverter"
                                              TrueValue="0,0,0,12" FalseValue="0" />

        <!--
            Selected-row tint (screen 2g: "selected rows tinted
            rgba(46,107,255,.05)") - SurfaceRowSelectedBrush (Theme.xaml,
            Task 1) is exactly that value. Reuses the existing
            BoolToBrushConverter (Task 4's HomePage already established this
            "instance configured via XAML properties" pattern for a bool ->
            brush swap) rather than a new converter class.
        -->
        <converters:BoolToBrushConverter x:Key="RowSelectedFillConverter"
                                          TrueBrush="{StaticResource SurfaceRowSelectedBrush}"
                                          FalseBrush="Transparent" />

        <!--
            Category filter chips (screen 2g line ~561-571) - judgment call:
            ListViewItem in this WinUI3 version has no Selected*/PointerOver*
            brush properties to set via an ItemContainerStyle (confirmed by
            a build attempt - WMC0090 "Unknown member" on all of them), so
            the chip's selected look is driven the same way Task 4's
            HomePage already drives its folder-tile selected look: a plain
            bool property on the bound model (CategorySidebarItem.IsSelected,
            set explicitly in ResultsPage.xaml.cs's
            CategorySidebar_SelectionChanged/PopulateCategorySidebar) read
            through BoolToBrushConverter instances, NOT the ListView's own
            native selection visuals. ItemContainerStyle below only resets
            layout chrome (padding/margin/borders) that WOULD otherwise come
            from the default ListViewItem template.
        -->
        <converters:BoolToBrushConverter x:Key="ChipBackgroundConverter"
                                          TrueBrush="{StaticResource AccentBrush}" FalseBrush="Transparent" />
        <converters:BoolToBrushConverter x:Key="ChipBorderConverter"
                                          TrueBrush="{StaticResource AccentBrush}"
                                          FalseBrush="{StaticResource SurfaceCardBorderBrush}" />
        <converters:BoolToBrushConverter x:Key="ChipForegroundConverter"
                                          TrueBrush="White" FalseBrush="{StaticResource TextMutedBrush}" />

        <Style x:Key="CategoryChipItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Bulk-select chips (All/None/Invert/Over-size, screen 2g line ~582-585) -->
        <Style x:Key="BulkChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="controls:PillCornerRadius.Enabled" Value="True" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Modified-date / Path-contains free-text fields (new-screens 4i) -->
        <Style x:Key="DateFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <!-- Height comes from symmetric padding, not MinHeight: an inflated
                 MinHeight leaves the placeholder pinned to the top because the
                 TextBox template doesn't center content in the extra space. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,9,12,9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Min/Max size NumberBox restyle (screen 2g's "min — MB"/"max — MB" pill fields).
             Spin buttons hidden - the ± chevrons cluttered the field and clashed
             with the pill filters; you type the value instead. -->
        <Style x:Key="SizeFilterNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="92" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Tame WinUI's default text-field chrome for the filter inputs (these six
            NumberBox/TextBox fields are the only text inputs on this page). Left
            alone, focus flips the fill toward white and draws a 2px accent
            underline - jarring on the dark surface and the reason the size /
            modified / copies / path fields looked out of place beside the pill
            filters. Keep the dark rounded look across rest/hover/focus, with a
            thin accent border (not an underline) as the only focus cue.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#C6CEE8" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8EDFF" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8EDFF" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7A84A6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7A84A6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A94B6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7A84A6" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <!-- The bordered shell of a size "value + unit" input group; the value
             TextBox and unit ComboBox inside it are chromeless (see the size
             row's StackPanel.Resources) so the whole thing reads as one field. -->
        <Style x:Key="SizeInputGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Copies + size-unit dropdowns, dark and rounded to match the fields. -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Modified-date pickers. Stretch to the rail width like the other fields. -->
        <Style x:Key="FilterDatePickerStyle" TargetType="CalendarDatePicker">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Match the dropdowns to the tamed text fields (dark surface, thin
             border, accent on press) instead of WinUI's default light chrome. -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#C6CEE8" />
        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#E8EDFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#E8EDFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#7A84A6" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#7A84A6" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF151A28" />
        <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#C6CEE8" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#9AA4C4" />

        <!-- Uppercase section heading inside the filter rail (8c). -->
        <Style x:Key="FilterSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="#6B7699" />
        </Style>

        <!--
            GroupsListView's two row kinds (assigned via RowTemplateSelector
            in ResultsPage.xaml.cs, not ListView.ItemTemplate) - see
            ResultsPage.xaml.cs's RebuildFlatRows/RowTemplateSelector doc
            comments for why the list is a single flat level instead of a
            group ListView nesting a per-group ItemsControl.

            Deliberate one-off literals below (#09FFFFFF/#12FFFFFF/#0FFFFFFF),
            not SurfaceCardBrush/SurfaceCardBorderBrush (Theme.xaml) - screen
            2g's group cards use a lighter alpha (0.035/0.07/0.06) than those
            shared tokens (0.043/0.08), a distinct value from the design
            spec, not an oversight - don't "simplify" this back to the
            StaticResource tokens. Every row (header and file) paints this
            same card-background color as its own base, rounded only at the
            card's actual top (header) or bottom (a group's last file) edge,
            so the flattened rows still read as one continuous card per
            group rather than a stack of separate boxes.
        -->
        <DataTemplate x:Key="ResultsHeaderRowTemplate">
            <!--
                Rail + indent wrapper (same on all three child-row templates):
                the 3px stripe in the owning section's colour plus the left
                inset is what makes rows read as BELONGING to the collapsible
                bar above them. The Rectangle stretches over the row's whole
                grid cell - including any inter-card margin - so the stripe
                runs continuously down the section instead of breaking at
                the gaps between group cards.
            -->
            <Grid Margin="8,0,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding SectionRailBrush}"
                           VerticalAlignment="Stretch" />
            <Border Grid.Column="1" CornerRadius="18,18,0,0" Background="#09FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1,1,1,0">
                <Border BorderThickness="0,0,0,1" BorderBrush="#0FFFFFFF" Padding="18,13">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="9" Height="9"
                                 Fill="{Binding Group.Files, Converter={StaticResource GroupSwatchBrushConverter}}"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Group.Files, Converter={StaticResource GroupRepresentativeFileNameConverter}}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Group.Files, Converter={StaticResource GroupCopiesLabelConverter}}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                controls:PillCornerRadius.Enabled="True"
                                Visibility="{Binding Group.IsLikelyCreatedTogether, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{StaticResource WarningFillBrush}" BorderBrush="{StaticResource WarningFillBorderBrush}"
                                BorderThickness="1" Padding="9,2">
                            <TextBlock Text="Created together — may belong to an app or set"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding Group.Files, Converter={StaticResource GroupFreesLabelConverter}}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResultsFileRowTemplate">
            <!-- Rail + indent wrapper - see ResultsHeaderRowTemplate's comment. -->
            <Grid Margin="8,0,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding SectionRailBrush}"
                           VerticalAlignment="Stretch" />
            <Border Grid.Column="1" Background="#09FFFFFF" BorderBrush="#12FFFFFF"
                    CornerRadius="{Binding IsLastInGroup, Converter={StaticResource LastInGroupCornerRadiusConverter}}"
                    BorderThickness="{Binding IsLastInGroup, Converter={StaticResource LastInGroupBorderThicknessConverter}}"
                    Margin="{Binding IsLastInGroup, Converter={StaticResource LastInGroupMarginConverter}}"
                    Opacity="{Binding IsOnNetworkDrive, Converter={StaticResource NetworkRowOpacityConverter}}">
                <Border Padding="18,10"
                        CornerRadius="{Binding IsLastInGroup, Converter={StaticResource LastInGroupCornerRadiusConverter}}"
                        Background="{Binding IsSelected, Converter={StaticResource RowSelectedFillConverter}}">
                    <Border.ContextFlyout>
                        <!--
                            WinUI does not propagate a target element's
                            DataContext into its ContextFlyout content - the
                            flyout is realized in a separate Popup root,
                            disconnected from the normal DataContext
                            inheritance chain (a long-documented WinUI/UWP
                            limitation: microsoft/microsoft-ui-xaml#911). The
                            Opening handler below copies it over explicitly
                            before the flyout shows, using the Target property
                            FlyoutBase sets to whatever element it was opened
                            from.
                        -->
                        <MenuFlyout Opening="FileRowContextMenu_Opening">
                            <MenuFlyoutItem Text="Open file" Click="OpenFile_Click" />
                            <MenuFlyoutItem Text="Open file location" Click="OpenFileLocation_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Ignore this file" Click="IgnoreFile_Click" Tag="ignore-file" />
                            <MenuFlyoutItem Text="Ignore this folder" Click="IgnoreFolder_Click" Tag="ignore-folder" />
                            <MenuFlyoutItem Text="Stop ignoring" Click="UnignoreFile_Click" Tag="unignore" />
                        </MenuFlyout>
                    </Border.ContextFlyout>

                    <Grid ColumnSpacing="14" Opacity="{Binding IsIgnored, Converter={StaticResource IgnoredRowOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>

                        <!-- IsSelectable = !network && !ignored: ignored rows (the
                             Ignored section reuses this template) must not offer a
                             live-looking checkbox when selection/deletion exclude
                             them. -->
                        <CheckBox Grid.Column="0" Width="20" Height="20" Padding="0"
                                  MinWidth="0" MinHeight="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Path, Converter={StaticResource FileNameFromPathConverter}}"
                                  IsEnabled="{Binding IsSelectable}"
                                  Checked="FileSelectionChanged" Unchecked="FileSelectionChanged"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Grid.Column="1" Width="44" Height="44"
                                CornerRadius="{StaticResource RadiusThumbnail}"
                                Background="{Binding Category, Converter={StaticResource CategoryFillBrushConverter}}"
                                Tapped="FileThumbnail_Tapped" Loaded="FileThumbnail_Loaded">
                            <Grid>
                                <ContentControl Content="{Binding Category}"
                                    ContentTemplate="{Binding Category, Converter={StaticResource CategoryIconTemplateConverter}}"
                                    Visibility="{Binding ShowCategoryGlyph, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding FileTypeIconSource}" Stretch="Uniform"
                                       Width="32" Height="32"
                                       Visibility="{Binding ShowFileTypeIcon, Converter={StaticResource BoolToVisibilityConverter}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}"
                                       ImageFailed="FileThumbnail_ImageFailed" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Path, Converter={StaticResource FileNameFromPathConverter}}"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="{StaticResource FontSizeRowFilename}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsIgnored, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="&#x1F6AB; IGNORED" FontFamily="{StaticResource BodyFontFamily}"
                                               FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </Border>
                                <!-- Best-copy hint for similarity/music/video rows
                                     ("BEST QUALITY" / "HIGHER RES" / "BIGGER FILE") -
                                     a hint, not a keep-recommendation (those sections
                                     are never auto-selected). -->
                                <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                        Background="{StaticResource SuccessFillBrush}"
                                        BorderBrush="{StaticResource SuccessFillBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasHintLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding HintLabel}" FontFamily="{StaticResource BodyFontFamily}"
                                               FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                                <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsOnNetworkDrive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="&#x2601; NETWORK DRIVE — can't remove from here"
                                               FontFamily="{StaticResource BodyFontFamily}"
                                               FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Path, Converter={StaticResource DirectoryFromPathConverter}}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource FontSizeFilePath}"
                                       Foreground="{StaticResource TextDisabledHintBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="3" Padding="12,4" controls:PillCornerRadius.Enabled="True"
                                Background="{StaticResource SuccessFillBrush}"
                                BorderBrush="{StaticResource SuccessFillBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsKeepRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding KeepRecommendedLabel}" FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </Border>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding LastWriteTimeUtc, Converter={StaticResource LastWriteDateConverter}}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="12" TextAlignment="Right" LineHeight="15"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="5"
                                   Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Border>
            </Grid>
        </DataTemplate>

        <!--
            Collapsible SECTION bar (Duplicates / Similar photos / … / Ignored).
            One row kind in the single virtualized _flatRows list - clicking it
            folds/unfolds that section by rebuilding the flat list (data only),
            so collapse/expand stays instant no matter how many files a section
            holds. Reads clearly as collapsible: a filled bar, a rotating
            chevron, a coloured type dot, bold title and a live file count.
        -->
        <DataTemplate x:Key="SectionBarRowTemplate">
            <Button Click="SectionHeader_Click" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0"
                    Background="Transparent" Margin="0,16,0,4"
                    AutomationProperties.Name="{Binding AutomationLabel}">
                <Border Background="{Binding BarFillBrush}" BorderBrush="{Binding BarBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusTile}" Padding="14,11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="11" Height="11" Fill="{Binding DotBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFontFamily}" FontSize="16"
                                   FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Padding="9,3" controls:PillCornerRadius.Enabled="True"
                                Background="{Binding BadgeFillBrush}" BorderBrush="{Binding BadgeBorderBrush}"
                                BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding BadgeText}" FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold" Foreground="{Binding BadgeTextBrush}" />
                        </Border>
                        <!-- Prominent circular collapse toggle so the bar clearly
                             reads as expandable, not just a heading. -->
                        <Border Grid.Column="5" Width="28" Height="28" controls:PillCornerRadius.Enabled="True"
                                Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronGlyph}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextBodyBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!--
            Sub-group header inside a section (a look-alike cluster, a song, or
            the single card that caps a flat blurry/ignored list). Rounds the top
            of its card; the group's last file row rounds the bottom.
        -->
        <DataTemplate x:Key="SubHeaderRowTemplate">
            <!-- Rail + indent wrapper - see ResultsHeaderRowTemplate's comment.
                 The card's own top margin stays on the inner Border so the rail
                 also spans the 10px gap above it, keeping the stripe continuous
                 between a section's clusters. -->
            <Grid Margin="8,0,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding SectionRailBrush}"
                           VerticalAlignment="Stretch" />
            <Border Grid.Column="1" CornerRadius="18,18,0,0" Background="#09FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1,1,1,0" Margin="0,10,0,0">
                <Border BorderThickness="0,0,0,1" BorderBrush="#0FFFFFFF" Padding="18,13">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                Background="{Binding HintFillBrush}" BorderBrush="{Binding HintBorderBrush}"
                                BorderThickness="1" VerticalAlignment="Center"
                                Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Hint}" FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold" Foreground="{Binding HintTextBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        Explicit flat background (DESIGN-SPEC.md §1: bg.base is for "flat
        screens (results lists)", unlike Home/Progress/Summary's bg.gradient)
        - MainWindow's root paints one continuous bg.gradient behind
        everything including the title bar, but a flat list screen like this
        one is meant to stay a single flat color throughout, not adopt that
        gradient's darker mid-screen dip. This doesn't reintroduce the
        black-title-bar bug the gradient fix addressed: bg.gradient's first
        stop is the same color as bg.base, so there's no visible seam where
        this page's flat background meets the title bar above it.
    -->
    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: inline back-link + screen title + stats + Export CSV (screen 2g line ~556-560, Export per 4i) -->
        <Grid Grid.Row="0" Padding="28,10,28,16" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <Button Click="BackToSummary_Click" Background="Transparent" BorderThickness="0" Padding="0"
                        AutomationProperties.Name="Back to Summary">
                    <TextBlock Text="&#x2190; Summary" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                </Button>
                <TextBlock x:Name="ScreenTitleText" Text="Duplicates" FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                           Foreground="{StaticResource TextHeadingBrush}" />
                <TextBlock x:Name="SummaryText" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Click="ExportCsv_Click" Style="{StaticResource BulkChipButtonStyle}"
                    Content="&#x21A7; Export CSV" AutomationProperties.Name="Export CSV" VerticalAlignment="Center" />
        </Grid>

        <!-- Body: permanent left filter rail + results list (8c Filter sidebar) -->
        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== FILTER RAIL ===== -->
            <Border Grid.Column="0" CornerRadius="16" Background="#08FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="18,18,18,16" Spacing="18">
                        <Grid>
                            <TextBlock Text="Filters" FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5"
                                       FontWeight="ExtraBold" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="Clear all" Click="ClearFilters_Click" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Foreground="{StaticResource AccentLightBrush}" FontFamily="{StaticResource BodyFontFamily}"
                                    FontSize="11.5" FontWeight="Bold" />
                        </Grid>

                        <!-- SHOW: a checklist (mirrors CATEGORY) - one row per
                             result-type section present in this scan, each with a
                             colour dot matching its section bar and a live file
                             count. ItemsSource filled in code-behind. -->
                        <StackPanel x:Name="SectionFilterGroup" Spacing="9">
                            <TextBlock Text="SHOW" Style="{StaticResource FilterSectionLabelStyle}" />
                            <ListView x:Name="SectionSidebar" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="SectionItem_Click"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0AFFFFFF" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="{StaticResource RadiusCheckbox}" BorderThickness="1.5"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IsSelected, Converter={StaticResource ChipBackgroundConverter}}"
                                                    BorderBrush="{Binding IsSelected, Converter={StaticResource ChipBorderConverter}}">
                                                <TextBlock Text="&#x2713;" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentLighterBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding SwatchBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontFamily="{StaticResource BodyFontFamily}"
                                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource ChipForegroundConverter}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Foreground="#6B7699" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Category as a checklist with live match counts -->
                        <StackPanel Spacing="9">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FilterSectionLabelStyle}" />
                            <ListView x:Name="CategorySidebar" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="CategoryItem_Click"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0AFFFFFF" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="{StaticResource RadiusCheckbox}" BorderThickness="1.5"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IsSelected, Converter={StaticResource ChipBackgroundConverter}}"
                                                    BorderBrush="{Binding IsSelected, Converter={StaticResource ChipBorderConverter}}">
                                                <TextBlock Text="&#x2713;" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentLighterBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding SwatchBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontFamily="{StaticResource BodyFontFamily}"
                                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource ChipForegroundConverter}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Foreground="#6B7699" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Size (value + MB/GB unit). The value box + unit dropdown
                             render chromeless so each SizeInputGroup border reads as
                             one field. Scoped here so the other rail controls keep
                             their normal look. -->
                        <StackPanel Spacing="8">
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#16FFFFFF" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1EFFFFFF" />
                            </StackPanel.Resources>
                            <TextBlock Text="SIZE" Style="{StaticResource FilterSectionLabelStyle}" />
                            <Border Style="{StaticResource SizeInputGroupStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="MinSizeValueBox" PlaceholderText="min" MinHeight="0"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="10,0,2,0"
                                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}" TextChanged="FilterChanged" />
                                    <ComboBox Grid.Column="1" x:Name="MinSizeUnitCombo" SelectedIndex="0" BorderThickness="0" MinWidth="56"
                                              VerticalAlignment="Center" Padding="6,0,6,0" FontFamily="{StaticResource MonoFontFamily}"
                                              FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="MB" />
                                        <ComboBoxItem Content="GB" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SizeInputGroupStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="MaxSizeValueBox" PlaceholderText="max" MinHeight="0"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="10,0,2,0"
                                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}" TextChanged="FilterChanged" />
                                    <ComboBox Grid.Column="1" x:Name="MaxSizeUnitCombo" SelectedIndex="0" BorderThickness="0" MinWidth="56"
                                              VerticalAlignment="Center" Padding="6,0,6,0" FontFamily="{StaticResource MonoFontFamily}"
                                              FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="MB" />
                                        <ComboBoxItem Content="GB" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Modified -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="MODIFIED" Style="{StaticResource FilterSectionLabelStyle}" />
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:Name="ModifiedAfterPicker" PlaceholderText="from"
                                                    DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                                    Style="{StaticResource FilterDatePickerStyle}" HorizontalAlignment="Stretch"
                                                    DateChanged="FilterChanged" />
                                <!-- Clears just this date (QA-19); shown only while one is set. Styled like "Clear all". -->
                                <Button x:Name="ClearModifiedAfterButton" Grid.Column="1" Content="&#x2715;" Click="ClearModifiedAfter_Click"
                                        Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0"
                                        VerticalAlignment="Stretch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                        ToolTipService.ToolTip="Clear the 'from' date" AutomationProperties.Name="Clear the from date" />
                            </Grid>
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:Name="ModifiedBeforePicker" PlaceholderText="to"
                                                    DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                                    Style="{StaticResource FilterDatePickerStyle}" HorizontalAlignment="Stretch"
                                                    DateChanged="FilterChanged" />
                                <!-- Clears just this date (QA-19); shown only while one is set. Styled like "Clear all". -->
                                <Button x:Name="ClearModifiedBeforeButton" Grid.Column="1" Content="&#x2715;" Click="ClearModifiedBefore_Click"
                                        Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0"
                                        VerticalAlignment="Stretch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                        ToolTipService.ToolTip="Clear the 'to' date" AutomationProperties.Name="Clear the to date" />
                            </Grid>
                        </StackPanel>

                        <!-- Path contains -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="PATH CONTAINS" Style="{StaticResource FilterSectionLabelStyle}" />
                            <TextBox x:Name="PathContainsBox" PlaceholderText="folder or file name"
                                     HorizontalAlignment="Stretch" Style="{StaticResource DateFilterTextBoxStyle}"
                                     TextChanged="FilterChanged" />
                        </StackPanel>

                        <!-- Copies + Extension -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="COPIES" Style="{StaticResource FilterSectionLabelStyle}" />
                                <ComboBox x:Name="CopiesCombo" PlaceholderText="any" HorizontalAlignment="Stretch" MinWidth="0"
                                          Style="{StaticResource FilterComboBoxStyle}" SelectionChanged="FilterChanged">
                                    <ComboBoxItem Content="2" />
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="6" />
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="9" />
                                    <ComboBoxItem Content="10+" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="EXT" Style="{StaticResource FilterSectionLabelStyle}" />
                                <ComboBox x:Name="ExtensionCombo" PlaceholderText="any" HorizontalAlignment="Stretch" MinWidth="0"
                                          Style="{StaticResource FilterComboBoxStyle}" SelectionChanged="FilterChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== LIST AREA ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Minimal list header: select actions + result count (8c) -->
                <Grid Grid.Row="0" Padding="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Select:" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <Button Content="All" Click="SelectAll_Click" Style="{StaticResource BulkChipButtonStyle}"
                                AutomationProperties.Name="Select All" />
                        <Button Content="None" Click="SelectNone_Click" Style="{StaticResource BulkChipButtonStyle}"
                                AutomationProperties.Name="Select None" />
                        <Button Content="Invert" Click="InvertSelection_Click" Style="{StaticResource BulkChipButtonStyle}"
                                AutomationProperties.Name="Invert Selection" />
                        <Button Content="More &#x25BE;" Style="{StaticResource BulkChipButtonStyle}"
                                AutomationProperties.Name="More select options">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Over 100 MB…" Click="SelectOver100Mb_Click" />
                                    <MenuFlyoutItem Text="By folder…" Click="SelectByFolder_Click" />
                                    <MenuFlyoutItem Text="Keep best (similar photos)" Click="KeepBestSimilar_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Ignore selected" Click="IgnoreSelected_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Border x:Name="RecommendedAppliedPill" Margin="6,0,0,0" Padding="12,6" controls:PillCornerRadius.Enabled="True"
                                Background="{StaticResource AccentSelectedFillBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" Visibility="Collapsed">
                            <TextBlock Text="&#x26A1; Recommended applied"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentLighterBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ResultCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource BodyFontFamily}" FontSize="12"
                               Foreground="{StaticResource TextFaintBrush}" />
                </Grid>

        <!--
            Grouped results list (screen 2g line ~588-664). ItemsSource is
            _flatRows (a flat header-then-files sequence), not
            _viewModel.Groups directly, and there's no ListView.ItemTemplate
            here - RowTemplateSelector is assigned in ResultsPage.xaml.cs's
            constructor instead, picking ResultsHeaderRowTemplate or
            ResultsFileRowTemplate per row. This used to be a ListView of
            groups, each nesting a second, non-virtualizing ItemsControl for
            that group's files - that nested collection was the confirmed
            root cause (via crash-dump analysis) of a native
            Microsoft.UI.Xaml access violation under fast scrollbar-drag
            scrolling: the outer ListView's virtualization was rapidly
            creating/destroying containers that each carried a whole second,
            unvirtualized collection. Flattening to one level means
            GroupsListView's own virtualization is the only one in play.
        -->
        <!--
            ShowsScrollingPlaceholders="False": during a fast scroll WinUI
            otherwise paints light-grey placeholder rectangles over every
            not-yet-realized row (the "white/grey flash" that looked like
            selected text sweeping down the list). Turning it off makes rows
            simply appear as they realize, with no grey flash.
        -->
                <ListView x:Name="GroupsListView" Grid.Row="1" Padding="0"
                  SelectionMode="None" IsItemClickEnabled="False"
                  ShowsScrollingPlaceholders="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!--
                Kill the default ListViewItem hover/press/selection tint. The
                rows draw their own selected/hover treatment (see the file-row
                template's RowSelectedFillConverter); the container-level tint
                otherwise flashes a grey highlight over whichever row sits
                under the stationary cursor while the list scrolls past it.
            -->
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBorderBrushPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <!--
                No add/reorder animations. Collapsing or filtering rebuilds the
                flat row list wholesale; without this WinUI plays a reposition
                transition on every realized row on each rebuild - the visible
                lag when toggling a section.
            -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
                </ListView>

                <!-- Empty state: shown by RebuildFlatRows when the current
                     filters/SHOW selection leave nothing to list. -->
                <StackPanel x:Name="EmptyStateText" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,0,0,60">
                    <TextBlock Text="Nothing matches these filters" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Adjust the filters on the left, or use Clear all to start over."
                               FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                               Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Sticky footer: live "will come home" stat + Remove Selected (screen 2g line ~665-671) -->
        <Border Grid.Row="2" Background="{StaticResource FooterBarAcrylicBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="SelectedSizeText" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource FontSizeFooterStat}" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="SelectedCalloutText" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                </StackPanel>
                <Button x:Name="RemoveButton" Click="RemoveButton_Click" HorizontalAlignment="Right"
                        Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="40,14" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Remove Selected &#x26A1;" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="16" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
            </Grid>
        </Border>

        <controls:MediaComparisonViewer x:Name="ComparisonViewer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" />
    </Grid>
</Page>
