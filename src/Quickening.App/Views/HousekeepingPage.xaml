<Page
    x:Class="Quickening.App.Views.HousekeepingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    NavigationCacheMode="Disabled">

    <!--
        Housekeeping (F5): the empty folders and zero-byte files a scan turned
        up, kept apart from the duplicate/large-file results because they're
        clutter to tidy, not copies or space hogs. A flat, pre-checked list per
        kind with the same Remove-to-Recycle-Bin flow as the other results pages.
    -->
    <Page.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="#6B7699" />
        </Style>

        <Style x:Key="BulkChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="controls:PillCornerRadius.Enabled" Value="True" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <DataTemplate x:Key="HousekeepingRowTemplate">
            <Border Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="#0DFFFFFF">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Width="20" Height="20" Padding="0" MinWidth="0" MinHeight="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Checked="ItemSelectionChanged" Unchecked="ItemSelectionChanged"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="18" VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="{StaticResource FontSizeRowFilename}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ParentDirectory}" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource FontSizeFilePath}"
                                   Foreground="{StaticResource TextDisabledHintBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: back-link + title + count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Padding="28,10,28,10" VerticalAlignment="Center">
            <Button Click="BackToSummary_Click" Background="Transparent" BorderThickness="0" Padding="0"
                    AutomationProperties.Name="Back to Summary">
                <TextBlock Text="&#x2190; Summary" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
            </Button>
            <TextBlock Text="Tidy up" FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                       Foreground="{StaticResource TextHeadingBrush}" />
            <TextBlock x:Name="SummaryText" FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Bulk-select toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="28,0,28,12">
            <TextBlock Text="Select:" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            <Button Content="All" Click="SelectAll_Click" Style="{StaticResource BulkChipButtonStyle}"
                    AutomationProperties.Name="Select All" />
            <Button Content="None" Click="SelectNone_Click" Style="{StaticResource BulkChipButtonStyle}"
                    AutomationProperties.Name="Select None" />
        </StackPanel>

        <!-- Body: two sections side by side (columns collapse to one when a
             section is empty - see RefreshSectionsAndCounts). -->
        <ScrollViewer Grid.Row="2" Padding="28,0,28,12" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EmptyFoldersColumn" Width="*" />
                    <ColumnDefinition x:Name="ZeroByteColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="EmptyFoldersSection" Grid.Column="0" VerticalAlignment="Top" Spacing="9">
                    <TextBlock x:Name="EmptyFoldersLabel" Style="{StaticResource SectionLabelStyle}" />
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="#09FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <ListView x:Name="EmptyFoldersList" SelectionMode="None" IsItemClickEnabled="False"
                                  ItemTemplate="{StaticResource HousekeepingRowTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ZeroByteSection" Grid.Column="1" VerticalAlignment="Top" Spacing="9">
                    <TextBlock x:Name="ZeroByteLabel" Style="{StaticResource SectionLabelStyle}" />
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="#09FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <ListView x:Name="ZeroByteFilesList" SelectionMode="None" IsItemClickEnabled="False"
                                  ItemTemplate="{StaticResource HousekeepingRowTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sticky footer: selected count + Remove Selected -->
        <Border Grid.Row="3" Background="{StaticResource FooterBarAcrylicBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <TextBlock x:Name="SelectedCalloutText" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button x:Name="RemoveButton" Click="RemoveButton_Click" HorizontalAlignment="Right"
                        Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="40,14" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Tidy Up &#x2728;" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="16" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
