<Page
    x:Class="Quickening.App.Views.LargeFilesResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Quickening.App.Converters"
    xmlns:controls="using:Quickening.App.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <!--
        Screen 2h in design-handoff/Quickening Screens.dc.html - Large Files
        results. Flat, biggest-first list (no grouping - behavioral rule 5:
        "Large Files = flat, biggest-first, no recommend"), modeled closely
        on ResultsPage.xaml's (Task 8) patterns/converters/styles but with a
        single continuous bordered ListView instead of a group-card wrapper.
        Flat background per DESIGN-SPEC.md §1, same as ResultsPage.
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:CategoryIconTemplateConverter x:Key="CategoryIconTemplateConverter" />
        <converters:CategoryFillBrushConverter x:Key="CategoryFillBrushConverter" />
        <converters:FileNameFromPathConverter x:Key="FileNameFromPathConverter" />
        <converters:DirectoryFromPathConverter x:Key="DirectoryFromPathConverter" />
        <converters:LastWriteDateConverter x:Key="LastWriteDateConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:RiskyPathVisibilityConverter x:Key="RiskyPathVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToDoubleConverter x:Key="NetworkRowOpacityConverter" TrueValue="0.55" FalseValue="1" />
        <converters:BoolToDoubleConverter x:Key="IgnoredRowOpacityConverter" TrueValue="0.45" FalseValue="1" />

        <converters:BoolToBrushConverter x:Key="RowSelectedFillConverter"
                                          TrueBrush="{StaticResource SurfaceRowSelectedBrush}" FalseBrush="Transparent" />

        <converters:BoolToBrushConverter x:Key="ChipBackgroundConverter"
                                          TrueBrush="{StaticResource AccentBrush}" FalseBrush="Transparent" />
        <converters:BoolToBrushConverter x:Key="ChipBorderConverter"
                                          TrueBrush="{StaticResource AccentBrush}"
                                          FalseBrush="{StaticResource SurfaceCardBorderBrush}" />
        <converters:BoolToBrushConverter x:Key="ChipForegroundConverter"
                                          TrueBrush="White" FalseBrush="{StaticResource TextMutedBrush}" />

        <Style x:Key="CategoryChipItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="BulkChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="controls:PillCornerRadius.Enabled" Value="True" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Untinted size field (2h's "max — MB"). Spin buttons hidden - the ±
             chevrons cluttered the field and clashed with the pill filters. -->
        <!-- Uppercase section heading inside the filter rail - copied from
             ResultsPage's identical page-local style so the two rails read the same. -->
        <Style x:Key="FilterSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="#6B7699" />
        </Style>

        <Style x:Key="SizeFilterNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Tinted/active size field (2h's pre-filled "min 500 MB" box -
            rgba(46,107,255,.12) fill + rgba(46,107,255,.5) border) - the min
            filter starts pre-filled with the scan's own threshold, so it
            starts in this "active" visual state rather than the placeholder
            look SizeFilterNumberBoxStyle uses.
        -->
        <Style x:Key="SizeFilterActiveNumberBoxStyle" TargetType="NumberBox" BasedOn="{StaticResource SizeFilterNumberBoxStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSelectedFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBodyEmphasisBrush}" />
        </Style>

        <!-- Path-contains free-text field (new-screens 4i) -->
        <Style x:Key="DateFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <!-- Height comes from symmetric padding, not MinHeight: an inflated
                 MinHeight leaves the placeholder pinned to the top because the
                 TextBox template doesn't center content in the extra space
                 (identical fix + comment in ResultsPage's DateFilterTextBoxStyle). -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,9,12,9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--
            Tame WinUI's default text-field chrome for the filter inputs, matching
            ResultsPage. Without this, focus flips the fill toward white and draws
            a 2px accent underline - jarring on the dark surface. Keep the dark
            rounded look across rest/hover/focus with a thin accent border as the
            only focus cue. The active (pre-filled) size box sets its own
            Background, which still wins over these defaults.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#C6CEE8" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8EDFF" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8EDFF" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7A84A6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7A84A6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A94B6" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7A84A6" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <!-- The following three styles + ComboBox brushes are copied verbatim from
             ResultsPage (Find Duplicates) so the shared filters render identically. -->
        <Style x:Key="SizeInputGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="CalendarDatePicker">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#0BFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#C6CEE8" />
        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#E8EDFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#E8EDFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#E8EDFF" />
    </Page.Resources>

    <!-- Explicit flat background - see ResultsPage.xaml's identical comment. -->
    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: inline back-link + screen title + stats + Export CSV (screen 2h, Export per 4i) -->
        <Grid Grid.Row="0" Padding="28,10,28,16" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <Button Click="BackToSummary_Click" Background="Transparent" BorderThickness="0" Padding="0"
                        AutomationProperties.Name="Back to Summary">
                    <TextBlock Text="&#x2190; Summary" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                </Button>
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                           Foreground="{StaticResource TextHeadingBrush}" />
                <TextBlock x:Name="SummaryText" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Click="ExportCsv_Click" Style="{StaticResource BulkChipButtonStyle}"
                    Content="&#x21A7; Export CSV" AutomationProperties.Name="Export CSV" VerticalAlignment="Center" />
        </Grid>

        <!-- Body: permanent left filter rail + results list. Mirrors ResultsPage
             (Find Duplicates) so the two modes share one filter interface. -->
        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== FILTER RAIL ===== -->
            <Border Grid.Column="0" CornerRadius="16" Background="#08FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="18,18,18,16" Spacing="18">
                        <Grid>
                            <TextBlock Text="Filters" FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5"
                                       FontWeight="ExtraBold" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="Clear all" Click="ClearFilters_Click" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Foreground="{StaticResource AccentLightBrush}" FontFamily="{StaticResource BodyFontFamily}"
                                    FontSize="11.5" FontWeight="Bold" />
                        </Grid>

                        <!-- SHOW: "Show ignored" as a CATEGORY-style checklist row
                             (rounded check + tick), not a stock CheckBox. Its
                             selected state is painted in code (UpdateShowIgnoredChip);
                             hover resources below match the category rows'
                             pointer-over tint instead of the stock Button fill. -->
                        <StackPanel Spacing="9">
                        <TextBlock Text="SHOW" Style="{StaticResource FilterSectionLabelStyle}" />
                        <Button x:Name="ShowIgnoredButton" Click="ShowIgnored_Toggle" Background="Transparent" BorderThickness="0"
                                CornerRadius="8" Padding="6,5" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" AutomationProperties.Name="Show ignored, off">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0AFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ShowIgnoredCheck" Grid.Column="0" Width="16" Height="16"
                                        CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center"
                                        Background="Transparent" BorderBrush="{StaticResource SurfaceCardBorderBrush}">
                                    <TextBlock x:Name="ShowIgnoredCheckMark" Text="&#x2713;" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource AccentLighterBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <TextBlock x:Name="ShowIgnoredLabel" Grid.Column="1" Text="Show ignored"
                                           FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Button>
                        </StackPanel>

                        <!-- Category as a multi-select checklist with live match
                             counts - identical to ResultsPage's CategorySidebar. All
                             categories are always shown (no "+N" collapse). -->
                        <StackPanel Spacing="9">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FilterSectionLabelStyle}" />
                            <ListView x:Name="CategorySidebar" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="CategoryItem_Click"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0AFFFFFF" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0AFFFFFF" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="{StaticResource RadiusCheckbox}" BorderThickness="1.5"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IsSelected, Converter={StaticResource ChipBackgroundConverter}}"
                                                    BorderBrush="{Binding IsSelected, Converter={StaticResource ChipBorderConverter}}">
                                                <TextBlock Text="&#x2713;" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentLighterBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding SwatchBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontFamily="{StaticResource BodyFontFamily}"
                                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource ChipForegroundConverter}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Foreground="#6B7699" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Size (value + MB/GB unit) - identical to ResultsPage. The
                             value box + unit dropdown render chromeless so each
                             SizeInputGroup border reads as one field. -->
                        <StackPanel Spacing="8">
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#16FFFFFF" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1EFFFFFF" />
                            </StackPanel.Resources>
                            <TextBlock Text="SIZE" Style="{StaticResource FilterSectionLabelStyle}" />
                            <Border Style="{StaticResource SizeInputGroupStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="MinSizeValueBox" PlaceholderText="min" MinHeight="0"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="10,0,2,0"
                                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}" TextChanged="FilterChanged" />
                                    <ComboBox Grid.Column="1" x:Name="MinSizeUnitCombo" SelectedIndex="0" BorderThickness="0" MinWidth="56"
                                              VerticalAlignment="Center" Padding="6,0,6,0" FontFamily="{StaticResource MonoFontFamily}"
                                              FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="MB" />
                                        <ComboBoxItem Content="GB" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SizeInputGroupStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="MaxSizeValueBox" PlaceholderText="max" MinHeight="0"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="10,0,2,0"
                                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}" TextChanged="FilterChanged" />
                                    <ComboBox Grid.Column="1" x:Name="MaxSizeUnitCombo" SelectedIndex="0" BorderThickness="0" MinWidth="56"
                                              VerticalAlignment="Center" Padding="6,0,6,0" FontFamily="{StaticResource MonoFontFamily}"
                                              FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="MB" />
                                        <ComboBoxItem Content="GB" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Modified date range (from/to) - identical to ResultsPage. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="MODIFIED" Style="{StaticResource FilterSectionLabelStyle}" />
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:Name="ModifiedAfterPicker" PlaceholderText="from"
                                                    DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                                    Style="{StaticResource FilterDatePickerStyle}" HorizontalAlignment="Stretch"
                                                    DateChanged="FilterChanged" />
                                <!-- Clears just this date (QA-19); shown only while one is set. Styled like "Clear all". -->
                                <Button x:Name="ClearModifiedAfterButton" Grid.Column="1" Content="&#x2715;" Click="ClearModifiedAfter_Click"
                                        Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0"
                                        VerticalAlignment="Stretch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                        ToolTipService.ToolTip="Clear the 'from' date" AutomationProperties.Name="Clear the from date" />
                            </Grid>
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:Name="ModifiedBeforePicker" PlaceholderText="to"
                                                    DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                                    Style="{StaticResource FilterDatePickerStyle}" HorizontalAlignment="Stretch"
                                                    DateChanged="FilterChanged" />
                                <!-- Clears just this date (QA-19); shown only while one is set. Styled like "Clear all". -->
                                <Button x:Name="ClearModifiedBeforeButton" Grid.Column="1" Content="&#x2715;" Click="ClearModifiedBefore_Click"
                                        Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0"
                                        VerticalAlignment="Stretch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                        ToolTipService.ToolTip="Clear the 'to' date" AutomationProperties.Name="Clear the to date" />
                            </Grid>
                        </StackPanel>

                        <!-- Path contains -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="PATH CONTAINS" Style="{StaticResource FilterSectionLabelStyle}" />
                            <TextBox x:Name="PathContainsBox" PlaceholderText="folder or file name"
                                     HorizontalAlignment="Stretch" Style="{StaticResource DateFilterTextBoxStyle}"
                                     TextChanged="FilterChanged" />
                        </StackPanel>

                        <!-- Extension -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="EXT" Style="{StaticResource FilterSectionLabelStyle}" />
                            <ComboBox x:Name="ExtensionCombo" PlaceholderText="any" HorizontalAlignment="Stretch" MinWidth="0"
                                      Style="{StaticResource FilterComboBoxStyle}" SelectionChanged="FilterChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== LIST AREA ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Bulk-select toolbar + showing-count (no "Recommended applied" pill: Large Files never has one) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="0,0,0,12">
                    <TextBlock Text="Select:" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                    <Button Content="All" Click="SelectAll_Click" Style="{StaticResource BulkChipButtonStyle}"
                            AutomationProperties.Name="Select All" />
                    <Button Content="None" Click="SelectNone_Click" Style="{StaticResource BulkChipButtonStyle}"
                            AutomationProperties.Name="Select None" />
                    <Button Content="Invert" Click="InvertSelection_Click" Style="{StaticResource BulkChipButtonStyle}"
                            AutomationProperties.Name="Invert Selection" />
                    <Button x:Name="SelectOverButton" Click="SelectOverThreshold_Click" Style="{StaticResource BulkChipButtonStyle}"
                            AutomationProperties.Name="Select over threshold" />
                    <Button Content="By folder…" Click="SelectByFolder_Click" Style="{StaticResource BulkChipButtonStyle}"
                            AutomationProperties.Name="Select By Folder" />
                    <TextBlock x:Name="ShowingCountText" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{StaticResource TextDisabledHintBrush}" />
                </StackPanel>

                <!-- Flat, continuous bordered list (screen 2h) - one Border, no per-group card wrapper -->
                <Grid Grid.Row="1" Padding="0">
            <Border CornerRadius="{StaticResource RadiusCard}" Background="#09FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                <ListView x:Name="FilesListView" SelectionMode="None" IsItemClickEnabled="False"
                          ShowsScrollingPlaceholders="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Suppress the container hover/press/selection tint (rows draw their own) so it doesn't flash grey during scroll. -->
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,11" BorderThickness="0,1,0,0" BorderBrush="#0DFFFFFF"
                                    Background="{Binding IsSelected, Converter={StaticResource RowSelectedFillConverter}}"
                                    Opacity="{Binding IsOnNetworkDrive, Converter={StaticResource NetworkRowOpacityConverter}}">
                                <Border.ContextFlyout>
                                    <!--
                                        See ResultsPage.xaml's identical comment on
                                        FileRowContextMenu_Opening - ContextFlyout content
                                        doesn't inherit its target's DataContext in WinUI,
                                        so the Opening handler copies it over explicitly.
                                    -->
                                    <MenuFlyout Opening="FileRowContextMenu_Opening">
                                        <MenuFlyoutItem Text="Open file" Click="OpenFile_Click" />
                                        <MenuFlyoutItem Text="Open file location" Click="OpenFileLocation_Click" />
                                        <MenuFlyoutItem Text="Preview" Click="Preview_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Select this file" Click="SelectThisFile_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Ignore this file" Click="IgnoreFile_Click" Tag="ignore-file" />
                                        <MenuFlyoutItem Text="Ignore this folder" Click="IgnoreFolder_Click" Tag="ignore-folder" />
                                        <MenuFlyoutItem Text="Stop ignoring" Click="UnignoreFile_Click" Tag="unignore" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <Grid ColumnSpacing="14" Opacity="{Binding IsIgnored, Converter={StaticResource IgnoredRowOpacityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <!-- IsSelectable = !network && !ignored: with "Show
                                         ignored" on, ignored rows are visible here and
                                         must not offer a live checkbox when selection/
                                         deletion (rightly) exclude them. -->
                                    <CheckBox Grid.Column="0" Width="20" Height="20" Padding="0"
                                              MinWidth="0" MinHeight="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Path, Converter={StaticResource FileNameFromPathConverter}}"
                                              IsEnabled="{Binding IsSelectable}"
                                              Checked="FileSelectionChanged" Unchecked="FileSelectionChanged"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Width="44" Height="44"
                                            CornerRadius="{StaticResource RadiusThumbnail}"
                                            Background="{Binding Category, Converter={StaticResource CategoryFillBrushConverter}}"
                                            Tapped="FileThumbnail_Tapped" Loaded="FileThumbnail_Loaded">
                                        <Grid>
                                            <ContentControl Content="{Binding Category}"
                                                ContentTemplate="{Binding Category, Converter={StaticResource CategoryIconTemplateConverter}}"
                                                Visibility="{Binding ShowCategoryGlyph, Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding FileTypeIconSource}" Stretch="Uniform"
                                                   Width="32" Height="32"
                                                   Visibility="{Binding ShowFileTypeIcon, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ImageFailed="FileThumbnail_ImageFailed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Path, Converter={StaticResource FileNameFromPathConverter}}"
                                                       FontFamily="{StaticResource BodyFontFamily}"
                                                       FontSize="{StaticResource FontSizeRowFilename}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBodyBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                                    Background="{StaticResource SurfaceCardBrush}"
                                                    BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsIgnored, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#x1F6AB; IGNORED" FontFamily="{StaticResource BodyFontFamily}"
                                                           FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource TextFaintBrush}" />
                                            </Border>
                                            <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                                    Background="{StaticResource WarningFillBrush}"
                                                    BorderBrush="{StaticResource WarningFillBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Path, Converter={StaticResource RiskyPathVisibilityConverter}}">
                                                <TextBlock Text="⚠ PROGRAM FILE" FontFamily="{StaticResource BodyFontFamily}"
                                                           FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <Border Padding="9,2" controls:PillCornerRadius.Enabled="True"
                                                    Background="{StaticResource SurfaceCardBrush}"
                                                    BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsOnNetworkDrive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#x2601; NETWORK DRIVE — can't remove from here"
                                                           FontFamily="{StaticResource BodyFontFamily}"
                                                           FontSize="{StaticResource FontSizeMicroPill}" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource TextFaintBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path, Converter={StaticResource DirectoryFromPathConverter}}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="{StaticResource FontSizeFilePath}"
                                                   Foreground="{StaticResource TextDisabledHintBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding LastWriteTimeUtc, Converter={StaticResource LastWriteDateConverter}}"
                                               FontFamily="{StaticResource BodyFontFamily}" FontSize="12" TextAlignment="Right" LineHeight="15"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="{StaticResource FontSizeRowSize}" FontWeight="Bold"
                                               Foreground="{StaticResource TextHeadingBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Sticky footer: total + selected count + risky-file callout + Remove Selected (screen 2h) -->
        <Border Grid.Row="2" Background="{StaticResource FooterBarAcrylicBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="SelectedSizeText" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource FontSizeFooterStat}" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="SelectedCalloutText" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                </StackPanel>
                <Button x:Name="RemoveButton" Click="RemoveButton_Click" HorizontalAlignment="Right"
                        Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="40,14" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Remove Selected &#x26A1;" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="16" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
            </Grid>
        </Border>

        <controls:MediaComparisonViewer x:Name="ComparisonViewer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" />
    </Grid>
</Page>
