<Page
    x:Class="Quickening.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Quickening.App.Converters"
    xmlns:controls="using:Quickening.App.Controls">

    <!--
        Screens 2a (Duplicates mode) / 2b (Large Files mode) in
        design-handoff/Quickening Screens.dc.html - see DESIGN-SPEC.md §5.
        MainWindow.xaml already draws the shared 48px title-bar strip above
        this page's Frame, so nothing here duplicates it; every top-offset
        below is measured from the top of this page's own content area,
        matching each screen's "padding-top" starting right after its
        identical header.
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:FolderTileIconFillConverter x:Key="FolderTileIconFillConverter" />

        <!--
            Tile selected-state visuals (blue border + tinted fill per 2a's
            "Downloads" tile) - driven by KnownFolderTile.IsSelected via
            these two converter instances rather than a Style/VisualState,
            since IsSelected already raises PropertyChanged (see
            HomePage.xaml.cs's SelectTile) and a plain Binding + converter
            is the simplest mechanism that reacts to that directly.
        -->
        <converters:BoolToBrushConverter x:Key="TileFillConverter"
                                          TrueBrush="{StaticResource AccentSelectedFillBrush}"
                                          FalseBrush="{StaticResource SurfaceCardBrush}" />
        <converters:BoolToBrushConverter x:Key="TileBorderConverter"
                                          TrueBrush="{StaticResource AccentSelectedFillBorderBrush}"
                                          FalseBrush="{StaticResource SurfaceCardBorderBrush}" />

        <!-- 2a: 3-column large tile (218x80, r20, size subtitle) -->
        <DataTemplate x:Key="DuplicatesTileTemplate">
            <!--
                Button.Padding reserves 8px above/6px right beyond the 218-
                wide card itself - exactly matching the checkmark badge's
                overhang below (Margin="0,-8,-6,0") - so the badge's negative
                margin lands inside the Button's own padded bounds instead of
                past its outer edge. Button clips content to its own bounds,
                which cut the badge's top and right edges off before this
                padding was added; ItemWidth="232" on DuplicatesTileList's
                ItemsWrapGrid already expects this exact 218+8+6=232 total
                width, so this isn't a new/uncounted-for size.
            -->
            <Button Click="FolderTile_Click" Background="Transparent" BorderThickness="0" Padding="8,8,6,0"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                <Grid Width="218">
                    <Border CornerRadius="20" Padding="18"
                            Background="{Binding IsSelected, Converter={StaticResource TileFillConverter}}"
                            BorderBrush="{Binding IsSelected, Converter={StaticResource TileBorderConverter}}"
                            BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusFolderTileIcon}"
                                    Background="{Binding IconTemplateKey, Converter={StaticResource FolderTileIconFillConverter}}">
                                <ContentControl ContentTemplate="{Binding IconTemplate}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBodyBrush}" />
                                <TextBlock Text="{Binding SizeLabel}" FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="12" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Selected-state checkmark badge, per 2a's Downloads tile -->
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource BgElevatedBrush}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-6,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#x2713;" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 2b: compact 6-across small tile (106px, r16, icon + label only) -->
        <DataTemplate x:Key="LargeFilesTileTemplate">
            <Button Click="FolderTile_Click" Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                <Border Width="106" CornerRadius="{StaticResource RadiusTile}" Padding="4,14,4,12"
                        Background="{Binding IsSelected, Converter={StaticResource TileFillConverter}}"
                        BorderBrush="{Binding IsSelected, Converter={StaticResource TileBorderConverter}}"
                        BorderThickness="1.5">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <ContentControl ContentTemplate="{Binding IconTemplate}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#AAB4D4"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True"
          DragEnter="RootGrid_DragEnter" DragOver="RootGrid_DragOver" DragLeave="RootGrid_DragLeave" Drop="RootGrid_Drop">

        <!--
            Ambient radial glow decorations - 2a's two absolutely-positioned
            radial-gradient divs (top-right violet, bottom-left blue).
            WinUI has no CSS radial-gradient equivalent, so each is an
            Ellipse filled with a RadialGradientBrush; hex/alpha stops are
            transcribed 1:1 from the handoff's rgba() values (rgba(102,72,255,0.18)
            -> #2E6648FF, rgba(46,107,255,0.16) -> #292E6BFF; the second
            exactly matches Theme.xaml's AccentColor #2E6BFF).
        -->
        <Ellipse Width="520" Height="460" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-160,-120,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E6648FF" Offset="0" />
                    <GradientStop Color="#006648FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="480" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-140,0,0,-200" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#292E6BFF" Offset="0" />
                    <GradientStop Color="#002E6BFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40">

                <TextBlock x:Name="HeroHeadlineText" Text="Your disk called." HorizontalAlignment="Center"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeHomeHeadline}"
                           FontWeight="Bold"
                           CharacterSpacing="{StaticResource TrackingTightHalfPx}"
                           Foreground="{StaticResource TextHeadingBrush}" />
                <TextBlock x:Name="HeroSubtitleText" Text="There's space in there it would love back. Let's go get it."
                           Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextMutedBrush}" />

                <!--
                    Segmented pill (2a/2b) - two plain Buttons (not
                    ToggleButtons) inside a pill Border. Judgment call: WinUI's
                    default ToggleButton ControlTemplate re-asserts its own
                    Background via VisualStateManager setters once the
                    Checked/PointerOver states activate, which unreliably
                    fights a directly-set Background property; since selection
                    here is already fully code-driven (not relying on native
                    IsChecked semantics), plain Buttons sidestep that and are
                    simpler to get right. x:Name="ModeToggle" is kept on the
                    outer Border per Step 1's naming list even though nothing
                    in code references it directly.
                -->
                <Border x:Name="ModeToggle" Margin="0,30,0,0" Padding="6" controls:PillCornerRadius.Enabled="True"
                        HorizontalAlignment="Center"
                        Background="#0DFFFFFF" BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="DuplicatesModeToggle" Click="ModeToggle_SelectionChanged"
                                controls:PillCornerRadius.Enabled="True" Padding="30,12" BorderThickness="0">
                            <TextBlock x:Name="DuplicatesModeToggleText" Text="&#x25EB; Find Duplicates"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="15.5" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="LargeFilesModeToggle" Click="ModeToggle_SelectionChanged"
                                controls:PillCornerRadius.Enabled="True" Padding="30,12" BorderThickness="0">
                            <TextBlock x:Name="LargeFilesModeToggleText" Text="&#x25A3; Find Large Files"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="15.5" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Duplicates mode: 2a's 3-column large tile grid -->
                <Grid x:Name="DuplicatesTilesPanel" Margin="0,34,0,0">
                    <ItemsControl x:Name="DuplicatesTileList" ItemTemplate="{StaticResource DuplicatesTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"
                                               ItemWidth="232" ItemHeight="94" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Large Files mode: 2b's threshold card + compact 6-across tile row -->
                <Border x:Name="ThresholdCard" Margin="0,18,0,0" Width="682" Padding="24,18"
                        CornerRadius="20" Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&quot;Large&quot; means at least&#8230;" VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="ThresholdValueText" Text="100 MB" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                        </Grid>
                        <!--
                            Real Slider (not a hand-drawn track), restyled via
                            its own theme-resource overrides in .Resources -
                            per DESIGN-SPEC.md §9 this is an accepted
                            alternative to a fully custom track/thumb
                            template, and it's what keeps
                            RangeBase.ValueChanged wired up for real (see
                            ThresholdSlider_ValueChanged). Continuous 1-100,
                            one integer per StepFrequency="1" - the number
                            alone doesn't mean anything until combined with
                            ThresholdUnitToggle's MB/GB pick below, unlike
                            the old fixed-preset design this replaced.

                            Minimum/Maximum/Value are deliberately NOT set
                            here - assigning RangeBase.Minimum/Maximum/Value
                            as literal XAML attributes on this control
                            crashes this app's specific unpackaged/
                            self-contained WinAppSDK 2.2.0 build with a native
                            fail-fast (0xc000027b, stowed XamlParseException/
                            "Failed to assign to property RangeBase.Minimum"
                            or "...Value") a few seconds after launch -
                            confirmed by bisection and a FirstChanceException
                            capture (Minimum="0"/Maximum="4"/"5" happened not
                            to trigger it in this file's earlier revisions,
                            but Minimum="1" does - not worth relying on which
                            specific literals are "safe"). HomePage's
                            constructor sets all three in code instead, after
                            InitializeComponent(), which does not trigger it.
                        -->
                        <!--
                            Snaps to a fixed set of thresholds (50 MB … 100 GB,
                            see HomePage.ThresholdTicks) rather than a free
                            1-100 range - a linear MB-or-GB slider couldn't
                            reach useful sizes between 100 MB and 1 GB. The
                            slider's Value is a tick INDEX (0..N-1), not a byte
                            size; Minimum/Maximum/Value are set in code (see
                            the constructor) for the same reason the old slider
                            was - literal XAML RangeBase attributes crash this
                            build.
                        -->
                        <!--
                            A transparent overlay Rectangle sits ON TOP of the
                            Slider and intercepts all pointer input. WinUI's
                            Slider positions its thumb from the live drag
                            gesture (not from Value) while a drag is in
                            progress, so SnapsTo/StepValues only snaps on
                            release - the thumb slides smoothly between stops
                            mid-drag. Routing pointer input through the overlay
                            instead means the thumb never drag-tracks the
                            pointer; we set Value to a whole tick index from
                            the pointer's X, and the thumb (positioned from
                            Value) jumps stop-to-stop as you drag, matching an
                            HTML range input's step= behavior.
                        -->
                        <Grid Margin="0,14,0,0">
                            <Slider x:Name="ThresholdSlider"
                                    StepFrequency="1" SmallChange="1" LargeChange="1"
                                    TickFrequency="1" TickPlacement="Outside" SnapsTo="StepValues"
                                    IsThumbToolTipEnabled="False"
                                    ValueChanged="ThresholdSlider_ValueChanged">
                                <Slider.Resources>
                                    <SolidColorBrush x:Key="SliderTrackFill" Color="#17FFFFFF" />
                                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#17FFFFFF" />
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2E6BFF" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#2E6BFF" />
                                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F5FF" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F2F5FF" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F2F5FF" />
                                </Slider.Resources>
                            </Slider>
                            <Rectangle x:Name="ThresholdSliderOverlay" Fill="Transparent"
                                       PointerPressed="ThresholdOverlay_PointerPressed"
                                       PointerMoved="ThresholdOverlay_PointerMoved"
                                       PointerReleased="ThresholdOverlay_PointerReleased"
                                       PointerCanceled="ThresholdOverlay_PointerReleased"
                                       PointerCaptureLost="ThresholdOverlay_PointerReleased" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="LargeFilesTilesPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="LargeFilesTileList" ItemTemplate="{StaticResource LargeFilesTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"
                                               ItemWidth="116" ItemHeight="86" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Drop-zone / browse affordance - shared by both modes -->
                <Button x:Name="BrowseButton" Click="BrowseButton_Click" Margin="0,14,0,0" Width="682"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Rectangle RadiusX="18" RadiusY="18" Fill="Transparent"
                                   Stroke="{StaticResource SecondaryButtonBorderBrush}"
                                   StrokeThickness="{StaticResource SecondaryButtonBorderThickness}"
                                   StrokeDashArray="4,3" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Spacing="8" Padding="14">
                            <TextBlock Text="+" FontSize="17" Foreground="{StaticResource AccentLightBrush}" />
                            <TextBlock Text="or drop / browse any folder" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- CTA + Recycle-Bin reassurance line - shared by both modes -->
                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,30,0,0">
                    <Button x:Name="CtaButton" Click="CtaButton_Click" Style="{StaticResource GradientPillButtonStyle}">
                        <Border controls:PillCornerRadius.Enabled="True" Padding="54,17" Background="{StaticResource CtaGradientBrush}">
                            <TextBlock x:Name="CtaButtonText" Text="&#x26A1; Scan Downloads for duplicates"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="18" FontWeight="Bold" CharacterSpacing="11" Foreground="White" />
                        </Border>
                    </Button>
                    <TextBlock Text="Everything goes to the Recycle Bin — nothing is ever gone for good."
                               HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextDisabledHintBrush}" />

                    <!--
                        Opt-in for look-alike (perceptual) photo matching. Off
                        by default so a plain Duplicates scan only does exact,
                        byte-identical matching (cheaper, and what most users
                        expect). Duplicates mode only - irrelevant in Large
                        Files mode (see UpdateModeVisuals for the show/hide).
                    -->
                    <StackPanel x:Name="IncludeSimilarRow" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="IncludeSimilarToggle" OnContent="" OffContent="" MinWidth="0"
                                      VerticalAlignment="Center" Toggled="IncludeSimilar_Changed" />
                        <TextBlock Text="Also look for similar photos." VerticalAlignment="Center"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Footer nav pills (new-screens/4b, not 4a per explicit
                    instruction) - labeled History + Settings pills below the
                    CTA, replacing the old single top-left gear-icon button.
                    Living inside this same scrollable StackPanel (rather
                    than as a separate Grid sibling like the old button) side-
                    steps the z-order/hit-testing bug documented in this
                    project's history entirely - there's no overlap with the
                    ScrollViewer to fight since this content doesn't extend
                    past it.
                -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,26,0,0">
                    <Button x:Name="HistoryButton" Click="HistoryButton_Click"
                            controls:PillCornerRadius.Enabled="True" Padding="20,11"
                            Background="#0BFFFFFF" BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                            AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ContentControl ContentTemplate="{StaticResource IconHistory}" VerticalAlignment="Center" />
                            <TextBlock Text="History" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="HistoryLifetimeStatText" VerticalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                            controls:PillCornerRadius.Enabled="True" Padding="20,11"
                            Background="#0BFFFFFF" BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ContentControl ContentTemplate="{StaticResource IconSettings}" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!--
                        coffee/6a: "Buy me a coffee" pill, same size/shape as its
                        siblings but warm-tinted (rgba(255,214,102,…) -> #..FFD666)
                        so it reads as friendly and distinct without competing with
                        the scan CTA above. Opens the 6c overlay, never the browser
                        directly.
                    -->
                    <Button x:Name="CoffeeButton" Click="CoffeeButton_Click"
                            controls:PillCornerRadius.Enabled="True" Padding="20,11"
                            Background="#12FFD666" BorderBrush="#4DFFD666" BorderThickness="1"
                            AutomationProperties.Name="Buy me a coffee">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ContentControl ContentTemplate="{StaticResource IconCoffee}" VerticalAlignment="Center" />
                            <TextBlock Text="Buy me a coffee" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#FFE9AE" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            Drag overlay (new-screens 4h, drag-and-drop half only - the
            multi-select tiles/queue-strip in that same mockup are explicitly
            out of scope, see the design brief's multi-folder-scanning
            exclusion). Full-window 2.5px dashed border per 4h's own spec
            (#7FADFF over rgba(11,16,38,.82)); IsHitTestVisible="False" so it
            never intercepts the Drop event meant for RootGrid underneath it.
        -->
        <Border x:Name="DragOverlay" Margin="10" CornerRadius="16"
                BorderBrush="#7FADFF" BorderThickness="2.5"
                Background="#D10B1026"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ContentControl ContentTemplate="{StaticResource IconDownloads}" HorizontalAlignment="Center" />
                <TextBlock Text="Drop it — we'll scan that folder." HorizontalAlignment="Center"
                           FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextHeadingBrush}" />
                <TextBlock x:Name="DragOverlayPathText" HorizontalAlignment="Center"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
