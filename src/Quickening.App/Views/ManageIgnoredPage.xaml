<Page
    x:Class="Quickening.App.Views.ManageIgnoredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    NavigationCacheMode="Disabled">

    <!--
        Manage Ignored Files (reached from Settings): lists the folders and files
        the user chose to Ignore, and only lets them REMOVE entries (un-ignore).
        It never touches the files on disk. Rows are built in code-behind since
        the list is dynamic.
    -->
    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Padding="28,10,28,16" VerticalAlignment="Center">
            <!-- Named for its destination ("← Home"), matching the other pages'
                 back links ("← Summary", "← Home") - Back_Click goes Home. -->
            <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="0"
                    AutomationProperties.Name="Back to Home">
                <TextBlock Text="&#x2190; Home" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
            </Button>
            <TextBlock Text="Ignored files" FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                       Foreground="{StaticResource TextHeadingBrush}" />
            <TextBlock x:Name="SummaryText" FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,0,28,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel" Spacing="18" MaxWidth="900" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</Page>
