<Page
    x:Class="Quickening.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    Background="{StaticResource BgBaseBrush}">

    <!--
        new-screens/4e (populated) + 4g (empty state) - MainWindow.xaml
        already draws the shared 48px title bar, so nothing here duplicates
        it. Every file this app has ever sent to the Recycle Bin, grouped by
        removal batch ("session"), most recent first - see
        SqliteStore.GetRemovalSessions/GetTrashLogForSession.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"
                    Padding="28,10,28,16">
            <Button Click="BackHome_Click" Background="Transparent" BorderThickness="0" Padding="0"
                    AutomationProperties.Name="Back to Home">
                <TextBlock Text="&#x2190; Home" FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
            </Button>
            <TextBlock Text="History" FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                       Foreground="{StaticResource TextHeadingBrush}" />
        </StackPanel>

        <!-- Populated state (4e) -->
        <Grid x:Name="PopulatedPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Lifetime stats + Empty Recycle Bin -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Padding="28,4,28,18">
                <Border Background="{StaticResource SuccessFillBrush}" BorderBrush="{StaticResource SuccessFillBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="20,20" Width="300">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="LifetimeBytesText" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="34" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="reclaimed, all time ⚡" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="20,20" Width="300">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="LifetimeFilesText" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" />
                        <TextBlock Text="files sent to the Recycle Bin" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,14"
                        VerticalAlignment="Stretch">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="EmptyRecycleBinButton" Click="EmptyRecycleBinButton_Click" Padding="20,9"
                                controls:PillCornerRadius.Enabled="True" Background="Transparent"
                                BorderBrush="#80FF8A5C" BorderThickness="1.5"
                                Content="Empty Recycle Bin…" HorizontalContentAlignment="Center"
                                FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5" FontWeight="Bold"
                                Foreground="#FF8A5C" />
                        <TextBlock Text="empties the whole Windows bin" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="11"
                                   Foreground="{StaticResource TextDisabledHintBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Session list -->
            <ScrollViewer Grid.Row="1" Padding="28,0,28,0">
                <ItemsControl x:Name="SessionsList" />
            </ScrollViewer>

            <TextBlock Grid.Row="2" Padding="28,12,28,16"
                       Text="This is Quickening's own log — files may have been restored or purged from the Recycle Bin since."
                       FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{StaticResource TextDisabledHintBrush}" />
        </Grid>

        <!-- Empty state (4g) -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,80,0,0" Visibility="Collapsed">
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="Transparent" Stroke="{StaticResource SurfaceCardBorderBrush}" StrokeThickness="1.5"
                         StrokeDashArray="4,3" />
                <ContentControl ContentTemplate="{StaticResource IconHistory}" Width="40" Height="40" />
            </Grid>
            <TextBlock Text="No history yet — your disk awaits." HorizontalAlignment="Center" Margin="0,32,0,0"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeEmptyStateHeadline}" FontWeight="Bold"
                       CharacterSpacing="{StaticResource TrackingTight1px}"
                       Foreground="{StaticResource TextHeadingBrush}" />
            <TextBlock Text="Every file Quickening ever moves to the Recycle Bin shows up here, with its original home."
                       HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="560" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextMutedBrush}" />
            <Button Click="RunFirstScan_Click" Style="{StaticResource GradientPillButtonStyle}" Margin="0,48,0,0">
                <Border controls:PillCornerRadius.Enabled="True" Padding="44,16" Background="{StaticResource CtaGradientBrush}">
                    <TextBlock Text="⚡ Run your first scan" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource FontSizeCta}" FontWeight="Bold" Foreground="White" />
                </Border>
            </Button>
        </StackPanel>
    </Grid>
</Page>
