<Page
    x:Class="Quickening.App.Views.NoDuplicatesFoundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quickening.App.Controls"
    Background="Transparent">

    <!--
        Screen 3a in design-handoff/Quickening Screens.dc.html - reached when
        a Duplicates scan finds no duplicate groups at all. Framed as a win
        (success badge/hue), not a dead end - the secondary action
        cross-sells Large Files mode on the SAME folder rather than just
        bouncing back to a blank Home (see NoDuplicatesFoundPage.xaml.cs's
        TryLargeFiles_Click, which prefills HomePage via
        HomePage.HomePagePrefillRequest).
    -->
    <Grid>
        <!-- Ambient glow: 3a's "radial-gradient(closest-side, rgba(94,231,183,0.11), rgba(94,231,183,0))" -->
        <Ellipse Width="680" Height="560" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-40,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1C5EE7B7" Offset="0" />
                    <GradientStop Color="#005EE7B7" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,118,0,0">
            <!-- Success badge: 120px circle, rgba(94,231,183,.08) fill / .35 border, per 3a -->
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="#145EE7B7" Stroke="#595EE7B7" StrokeThickness="1.5" />
                <Viewbox Width="48" Height="48">
                    <Canvas Width="48" Height="48">
                        <Polyline Points="12,25 21,34 37,15"
                                  Stroke="{StaticResource SuccessBrush}" StrokeThickness="4.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <TextBlock Text="Squeaky clean." HorizontalAlignment="Center" Margin="0,32,0,0"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeEmptyStateHeadline}" FontWeight="Bold"
                       CharacterSpacing="{StaticResource TrackingTight1px}"
                       Foreground="{StaticResource TextHeadingBrush}" />

            <TextBlock x:Name="SubtitleText" HorizontalAlignment="Center" Margin="0,12,0,0"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextMutedBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,56,0,0">
                <Button Click="ScanAnotherFolder_Click" Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="44,16" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Scan another folder" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="{StaticResource FontSizeCta}" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
                <Button Content="&#x25A3; Try Large Files here instead" Click="TryLargeFiles_Click"
                        Padding="36,16" controls:PillCornerRadius.Enabled="True" Background="Transparent"
                        Foreground="{StaticResource TextBodyEmphasisBrush}"
                        FontFamily="{StaticResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold"
                        BorderBrush="{StaticResource SecondaryButtonBorderBrush}" BorderThickness="1.5" />
            </StackPanel>

            <TextBlock x:Name="HeavyweightHintText"
                       Text="Big folders often hide heavyweights even when there are no duplicates."
                       HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12.5"
                       Foreground="{StaticResource TextDisabledHintBrush}" />
        </StackPanel>
    </Grid>
</Page>
