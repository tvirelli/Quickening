<Page
    x:Class="Quickening.App.Views.CelebrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quickening.App.Controls"
    mc:Ignorable="d">

    <!--
        Screen 2l in design-handoff/Quickening Screens.dc.html - the
        celebration moment shown after a removal that fully succeeded (no
        failed files - see ResultsPage.xaml.cs's RemoveSelectedFilesAsync,
        Task 9). Bolt + headline pop in with qk-pop; six category-hued
        confetti dots float with qk-float, staggered per-dot per the
        handoff's own per-dot timing/positions.
    -->
    <Grid>

        <!-- Ambient radial glow (2l: "radial-gradient(closest-side, rgba(94,231,183,0.13), rgba(94,231,183,0))") -->
        <Ellipse Width="760" Height="620" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-100,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#215EE7B7" Offset="0" />
                    <GradientStop Color="#005EE7B7" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Confetti dots - positions/colors/per-dot float duration ported from screen 2l -->
        <Ellipse x:Name="Confetti1" Width="10" Height="10" Fill="{StaticResource CategoryAudioBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="320,190,0,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti1Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Confetti2" Width="8" Height="8" Fill="{StaticResource CategoryImageBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,350,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti2Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Confetti3" Width="7" Height="7" Fill="{StaticResource CategoryDocumentBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="250,320,0,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti3Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Confetti4" Width="11" Height="11" Fill="{StaticResource CategoryArchiveBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,360,270,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti4Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Confetti5" Width="6" Height="6" Fill="{StaticResource CategoryVideoBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="380,480,0,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti5Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Confetti6" Width="9" Height="9" Fill="{StaticResource AccentLightBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,470,400,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Confetti6Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,108,0,0">
            <Viewbox x:Name="BoltIcon" Width="60" Height="82" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="BoltScale" ScaleX="0.6" ScaleY="0.6" />
                </Viewbox.RenderTransform>
                <Canvas Width="34" Height="46">
                    <Polygon Points="20,2 6,26 15,26 12,44 28,18 18,18" Fill="{StaticResource SuccessBrush}" />
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="HeadlineTextBlock" HorizontalAlignment="Center" Margin="0,26,0,0"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSizeCelebrationHeadline}" FontWeight="Bold"
                       CharacterSpacing="{StaticResource TrackingTight2px}"
                       Foreground="{StaticResource TextHeadingBrush}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="HeadlineScale" ScaleX="0.6" ScaleY="0.6" />
                </TextBlock.RenderTransform>
                <!-- No padding spaces inside the Runs: XAML already inserts one
                     between adjacent Runs, which doubled them ("Nice —  128 KB  back!"). -->
                <Run Text="Nice —" />
                <Run x:Name="HeadlineSizeText" Foreground="{StaticResource SuccessBrush}" />
                <Run Text="back!" />
            </TextBlock>

            <TextBlock x:Name="SubtitleText" HorizontalAlignment="Center" Margin="0,14,0,0"
                       FontSize="17" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640" />

            <Border HorizontalAlignment="Center" Margin="0,20,0,0" Padding="22,12"
                    controls:PillCornerRadius.Enabled="True"
                    Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Lifetime total with Quickening:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="LifetimeTotalText" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,52,0,0">
                <Button Click="ScanAnotherFolder_Click" Style="{StaticResource GradientPillButtonStyle}">
                    <Border controls:PillCornerRadius.Enabled="True" Padding="44,16" Background="{StaticResource CtaGradientBrush}">
                        <TextBlock Text="Scan another folder" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="{StaticResource FontSizeCta}" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Button>
                <Button x:Name="ReviewWhatsLeftButton" Content="Review what's left" Click="ReviewWhatsLeft_Click" Padding="36,16"
                        controls:PillCornerRadius.Enabled="True" Background="Transparent"
                        Foreground="{StaticResource TextBodyEmphasisBrush}"
                        FontFamily="{StaticResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold"
                        BorderBrush="{StaticResource SecondaryButtonBorderBrush}" BorderThickness="1.5" />
            </StackPanel>

            <!--
                coffee/6b: warm-tinted "just saved you X — buy me a coffee?"
                line, riding the good mood right after a successful removal.
                Copy pulls the real just-reclaimed figure from the session
                (set in OnNavigatedTo); opens the 6c overlay, never the
                browser directly.
            -->
            <Button x:Name="CoffeeLineButton" Click="CoffeeLine_Click" Margin="0,34,0,0"
                    HorizontalAlignment="Center" controls:PillCornerRadius.Enabled="True" Padding="24,12"
                    Background="#12FFD666" BorderBrush="#4DFFD666" BorderThickness="1"
                    AutomationProperties.Name="Buy me a coffee">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ContentControl ContentTemplate="{StaticResource IconCoffee}" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="14" FontWeight="Bold" Foreground="#FFE9AE">
                        <Run Text="Quickening just saved you " /><Run x:Name="CoffeeLineSizeText" /><Run Text=" — buy me a coffee?" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Reminder banner + Undo toast (new-screens 4j) - built in code-behind
             (see BuildReminderBanner/BuildUndoToast) matching this project's
             established hand-built-control convention (SettingsDialog.cs,
             EmptyRecycleBinDialog.cs), rather than a large inline XAML block. -->
        <ContentControl x:Name="ReminderBannerHost" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Margin="28,20,28,0" Visibility="Collapsed" />
        <ContentControl x:Name="UndoToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,26" Visibility="Collapsed" />
    </Grid>
</Page>
