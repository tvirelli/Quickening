<UserControl
    x:Class="Quickening.App.Controls.ProgressRingArc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="260" Height="260">
        <Path x:Name="TrackPath" Stroke="#0FFFFFFF" StrokeThickness="14" />
        <Path x:Name="ArcPath" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="ArcRotation" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</UserControl>
