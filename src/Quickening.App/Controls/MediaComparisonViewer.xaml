<UserControl
    x:Class="Quickening.App.Controls.MediaComparisonViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Full-window scrim layer (screen 2j) - hosted at Grid.Row="0"
        Grid.RowSpan full-page by ResultsPage.xaml/LargeFilesResultsPage.xaml,
        matching DESIGN-SPEC.md §9's "full-window Grid layer" note for the
        media preview overlay.
    -->
    <Grid Background="{StaticResource ScrimMediaPreviewBrush}">
        <Grid Margin="60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: "{filename} - N copies, compared" + subtitle + circular close -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource FontSizeScreenTitle}" FontWeight="Bold"
                               Foreground="{StaticResource TextHeadingBrush}" />
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!--
                    Solid dark backing + bright glyph + visible ring so the
                    close affordance reads clearly over ANY previewed media
                    (a bright photo or a dark video frame) - the old 7%-white
                    fill vanished against light images.
                -->
                <Button Grid.Column="1" Click="Close_Click" VerticalAlignment="Top"
                        Width="44" Height="44" Padding="0" CornerRadius="22"
                        Background="#CC0B1026" BorderBrush="#66FFFFFF" BorderThickness="1.5"
                        Foreground="White" FontSize="18" FontWeight="Bold" Content="&#x2715;"
                        ToolTipService.ToolTip="Close preview" />
            </Grid>

            <!--
                Responsive tile grid, populated in code (see LayoutPanels):
                min(count,4) star columns × ceil(count/cols) star rows, so a
                single item fills the whole area (large, centered) while 2/3/4
                split it 50/33/25% each, and 5+ wrap at 4 per row. Star sizing
                means every tile fluidly fills its own cell rather than a fixed
                width, and each tile's media letterboxes (Uniform) to fit with
                no cropping.
            -->
            <Grid x:Name="PanelsGrid" Grid.Row="1" Margin="0,24,0,0" />

            <TextBlock Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource BodyFontFamily}" FontSize="12.5"
                       Foreground="{StaticResource TextDisabledHintBrush}"
                       Text="Checkboxes are the same selection you see on Results — one truth, two views." />
        </Grid>
    </Grid>
</UserControl>
