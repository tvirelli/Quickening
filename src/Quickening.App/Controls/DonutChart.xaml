<UserControl
    x:Class="Quickening.App.Controls.DonutChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Screen 2e's donut has no backing shape or icon behind its center
        content - just the reclaimable-total number directly on the dark
        page background (unlike the earlier Gemini-fidelity design, which
        had a white CenterBacking circle behind a generic CenterIcon glyph;
        both were removed, not adapted, since 2e has no equivalent for
        either - see DonutChart.xaml.cs).
    -->
    <Grid>
        <Canvas x:Name="ArcCanvas" />
        <StackPanel x:Name="CenterContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <TextBlock x:Name="CenterTotalText" HorizontalAlignment="Center"
                       FontFamily="{StaticResource DisplayFontFamily}" FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource TextHeadingBrush}" />
            <TextBlock Text="reclaimable" HorizontalAlignment="Center" FontSize="12.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
