<Window
    x:Class="Quickening.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The one and only background paint for the whole window - BgGradientBrush
        spans this root Grid's full height (title bar row + content row
        together), so the gradient flows continuously behind both instead of
        each page repainting its own separate copy starting fresh below the
        title bar (which read as two stacked, disconnected color blocks -
        a flat title-bar strip sitting on top of a page's own gradient - not
        one continuous background). Every page below sets no Background of
        its own (or Transparent) so this single gradient shows through
        everywhere; ContentFrame.Background is explicitly Transparent since
        Frame's default theme background is opaque.
    -->
    <Grid Background="{StaticResource BgGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            48px title-bar strip, extended-into via ExtendsContentIntoTitleBar
            in code-behind. Native Windows caption buttons render themselves
            (styled via AppWindowTitleBar in code-behind, not drawn here) -
            this Grid only supplies the draggable region and the wordmark
            logo (logo.png already contains the icon; the separate icon.png
            was removed as redundant per 2026-07-11 feedback).
        -->
        <!--
            The strip is split so the right side can host an INTERACTIVE
            element: SetTitleBar(TitleBarRegion) turns that element's bounds
            into the non-client drag region, which swallows pointer input -
            so the Recycle Bin pill lives in its own sibling column instead.
            Its right margin is set in code from AppWindowTitleBar.RightInset
            so it never sits under the system caption buttons at any DPI.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleBarRegion" Grid.Column="0" Padding="20,0,0,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 32 in the 48px strip, nudged down (top margin) per
                         2026-07-11 feedback; 38 left the wordmark visually
                         glued to the top edge. -->
                    <Image Source="ms-appx:///Assets/Branding/logo.png" Height="32" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- Recycle Bin indicator: only shown while Windows' bin actually
                 holds items (refreshed on navigation + a slow timer). Click
                 opens the press-and-hold Empty-Recycle-Bin dialog. -->
            <Button x:Name="RecycleBinPill" Grid.Column="1" Click="RecycleBinPill_Click"
                    Visibility="Collapsed" VerticalAlignment="Center" Margin="0,6,150,0"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="12,4" controls:PillCornerRadius.Enabled="True"
                    xmlns:controls="using:Quickening.App.Controls"
                    ToolTipService.ToolTip="The Windows Recycle Bin has items in it — click to empty it">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE74D;" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="RecycleBinPillText" FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" />

        <!--
            One-time post-update note ("Updated to vX"), floated over the top
            of the content area. Opened by ShowUpdateNote and auto-dismissed a
            few seconds later; the user can also close it. Row 1 so it overlays
            page content, not the title bar.
        -->
        <InfoBar
            x:Name="UpdateNote"
            Grid.Row="1"
            VerticalAlignment="Top"
            Margin="20,12,20,0"
            IsOpen="False"
            Severity="Success" />
    </Grid>
</Window>
