<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickening.Core\Quickening.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SynchronousProgress.cs" Link="Shared\SynchronousProgress.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serial test collections (see xunit.runner.json): RecycleBinServiceTests
         drives the real Windows shell (COM IFileOperation) and intermittently
         CRASHED the test host when other collections ran concurrently - vstest
         then printed "Passed!" for a silently TRUNCATED run (totals varied
         193-207 across identical invocations). Whole suite still runs in ~2s. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
